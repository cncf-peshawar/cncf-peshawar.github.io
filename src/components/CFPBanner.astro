---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cfp-banner">
  <div class="container">
    <div class="cfp-box">
      <div class="cfp-box__decoration" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none">
          <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="2" stroke-dasharray="8 8"/>
          <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="1.5"/>
          <path d="M70 110 A 30 30 0 0 1 120 85 A 25 25 0 0 1 150 110 Z" fill="currentColor" opacity="0.4"/>
        </svg>
      </div>
      <div class="cfp-box__content">
        <span class="cfp-box__tag">
          <span class="material-symbols-outlined">record_voice_over</span>
          Call for Proposals (CFP) · Always Open
        </span>
        <h2 class="cfp-box__title">Have a Cloud Native Story or Architecture to Share?</h2>
        <p class="cfp-box__desc">
          Whether you are a seasoned Kubernetes maintainer, a DevOps engineer troubleshooting production outages, or a student experimenting with WebAssembly and Linux containers—our stage is yours.
        </p>
        <div class="cfp-box__formats">
          <span class="format-chip">15-Min Lightning Talk</span>
          <span class="format-chip">40-Min Deep Dive Session</span>
          <span class="format-chip">90-Min Hands-On Workshop</span>
        </div>
      </div>

      <div class="cfp-box__action">
        <a href={`${base}/speak`} class="btn btn--accent">
          <span>Apply to Speak at CNCF Peshawar</span>
          <span class="material-symbols-outlined">campaign</span>
        </a>
        <span class="cfp-box__reassurance">First-time speakers receive 1-on-1 coaching & slide review.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cfp-banner {
    padding-block: var(--space-2xl);
  }

  .cfp-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding: clamp(var(--space-lg), 5vw, var(--space-2xl));
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .cfp-box {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }
  }

  .cfp-box__decoration {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 33%;
    opacity: 0.08;
    color: var(--color-signal-green);
    pointer-events: none;
    display: none;
  }

  @media (min-width: 900px) {
    .cfp-box__decoration {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .cfp-box__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .cfp-box__tag .material-symbols-outlined {
    font-size: 16px;
  }

  .cfp-box__title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-sm);
    line-height: var(--line-height-snug);
  }

  .cfp-box__desc {
    font-size: var(--font-size-base);
    color: var(--color-ink-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-lg);
  }

  .cfp-box__formats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .format-chip {
    padding: 0.3rem 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    background-color: var(--color-paper-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }

  .cfp-box__action {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .cfp-box__action {
      align-items: flex-end;
      text-align: right;
    }
  }

  .cfp-box__reassurance {
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
  }
</style>
