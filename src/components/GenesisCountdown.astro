---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event?: CollectionEntry<'events'> | null;
  targetDate?: string;
}

const { event, targetDate } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = event?.data.title ?? "The Cloud Native Launchpad: Docker, Kubernetes & Real Deployments.";
const dateStr = event?.data.date ?? "2026-09-26";
const timeStr = event?.data.time ?? "03:00 PM - 07:00 PM PKT";
const venueStr = event?.data.venue ?? "NIC (National Incubation Center), South Canal Road, Peshawar";
const rsvpUrl = event?.data.rsvpUrl ?? "https://ocgroups.dev/cncf/group/6vwk2n4/event/wpm4sp7";
const lumaUrl = event?.data.lumaUrl;
const eventSlug = event?.slug ?? "02-the-cloud-native-launchpad-docker-kubernetes-real-deployments";

// Format date nicely (e.g. SEP 26, 2026)
const dateFormatted = new Date(dateStr).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).toUpperCase();

// Form ISO target date string for countdown
const effectiveTarget = targetDate || (event?.data.date ? `${event.data.date}T15:00:00+05:00` : "2026-09-26T15:00:00+05:00");
---

<div class="countdown-card" data-target={effectiveTarget}>
  <div class="countdown-card__header">
    <div class="countdown-card__live-indicator">
      <span class="live-dot" id="cd-live-dot"></span>
      <span class="live-label" id="cd-live-label">COUNTDOWN TO {title.toUpperCase()}</span>
    </div>
    <span class="section-eyebrow countdown-eyebrow">00 // UPCOMING MEETUP</span>
    <h2 class="featured-title">{title}</h2>
    <span id="cd-date-display">{dateFormatted} · {timeStr}</span>
  </div>

  <div class="countdown-grid" id="genesis-countdown">
    <div class="countdown-box">
      <span id="cd-days">--</span>
      <span class="countdown-unit">DAYS</span>
    </div>
    <div class="countdown-box">
      <span id="cd-hours">--</span>
      <span class="countdown-unit">HOURS</span>
    </div>
    <div class="countdown-box">
      <span id="cd-mins">--</span>
      <span class="countdown-unit">MINUTES</span>
    </div>
    <div class="countdown-box">
      <span id="cd-secs">--</span>
      <span class="countdown-unit">SECONDS</span>
    </div>
  </div>

  <div class="countdown-venue">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>
    <span>{venueStr}</span>
  </div>

  <div class="countdown-actions" id="cd-actions">
    <a href={`${base}/events/${eventSlug}`} class="btn btn-outline btn-sm">
      <span>View Details →</span>
    </a>
    {rsvpUrl && (
      <a 
        href={rsvpUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-sky btn-sm"
        id="cd-rsvp-btn"
      >
        <span>RSVP on OCG (Free)</span>
      </a>
    )}
    {lumaUrl && (
      <a 
        href={lumaUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-outline btn-sm"
      >
        <span>Luma ↗</span>
      </a>
    )}
  </div>
</div>

<style>
  .countdown-card {
    background: var(--color-canary-banner, #ffde00);
    border: 2px solid var(--color-charcoal-ink, #383838);
    border-radius: var(--radius, 2px);
    box-shadow: -6px 6px 0px 0px var(--color-charcoal-ink, #383838);
    padding: clamp(24px, 4vw, 36px) clamp(20px, 4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 24px;
    transition: box-shadow 0.1s ease;
  }

  .countdown-card--concluded {
    background: var(--color-canary-banner, #ffde00);
    box-shadow: -6px 6px 0px 0px var(--color-charcoal-ink, #383838);
  }

  .countdown-card__header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .countdown-card__live-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .live-dot {
    width: 10px;
    height: 10px;
    background: var(--color-mint-sketch, #38c1b0);
    border: 1.5px solid var(--color-charcoal-ink, #383838);
    border-radius: 50%;
    display: inline-block;
    animation: pulse-live 2s infinite ease-in-out;
  }

  .live-dot--concluded {
    background: var(--color-pencil-gray, #a1a1a1);
    animation: none;
  }

  @keyframes pulse-live {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.7; }
  }

  .live-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-charcoal-ink, #383838);
  }

  .countdown-eyebrow {
    color: var(--color-charcoal-ink, #383838) !important;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .featured-title {
    font-size: clamp(1.4rem, 3.5vw, 1.8rem);
    font-weight: 700;
    color: var(--color-charcoal-ink, #383838);
    line-height: 1.25;
  }

  #cd-date-display {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-charcoal-ink, #383838);
    background: var(--color-frost-white, #ffffff);
    padding: 4px 10px;
    border: 1.5px solid var(--color-charcoal-ink, #383838);
    border-radius: var(--radius, 2px);
    display: inline-block;
    width: fit-content;
  }

  /* Countdown Grid */
  #genesis-countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: center;
  }

  @media (max-width: 600px) {
    #genesis-countdown {
      gap: 8px;
    }
  }

  .countdown-box {
    background: var(--color-frost-white, #ffffff);
    border: 2px solid var(--color-charcoal-ink, #383838);
    border-radius: var(--radius, 2px);
    box-shadow: -3px 3px 0px 0px var(--color-charcoal-ink, #383838);
    padding: clamp(14px, 3vw, 20px) clamp(8px, 2vw, 14px);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #cd-days, #cd-hours, #cd-mins, #cd-secs {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--color-charcoal-ink, #383838);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .countdown-unit {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted, #6b6b6b);
    letter-spacing: 0.05em;
  }

  .countdown-venue {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-charcoal-ink, #383838);
  }

  .countdown-venue svg {
    flex-shrink: 0;
  }

  #cd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
</style>

<script>
  function initCountdown() {
    const container = document.querySelector('.countdown-card');
    if (!container) return;

    const targetDateStr = container.getAttribute('data-target') || '2026-09-26T15:00:00+05:00';
    const targetTime = new Date(targetDateStr).getTime();

    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minsEl = document.getElementById('cd-mins');
    const secsEl = document.getElementById('cd-secs');
    const liveDot = document.getElementById('cd-live-dot');
    const liveLabel = document.getElementById('cd-live-label');
    const rsvpBtn = document.getElementById('cd-rsvp-btn');

    if (isNaN(targetTime)) {
      if (daysEl) daysEl.innerText = '00';
      if (hoursEl) hoursEl.innerText = '00';
      if (minsEl) minsEl.innerText = '00';
      if (secsEl) secsEl.innerText = '00';
      return;
    }

    let intervalId: number | undefined;

    function update() {
      const now = new Date().getTime();
      const diff = targetTime - now;

      if (diff <= 0) {
        if (daysEl) daysEl.innerText = '00';
        if (hoursEl) hoursEl.innerText = '00';
        if (minsEl) minsEl.innerText = '00';
        if (secsEl) secsEl.innerText = '00';
        if (liveLabel) liveLabel.textContent = 'EVENT CONCLUDED · RECAPS AVAILABLE';
        if (liveDot) liveDot.classList.add('live-dot--concluded');
        container?.classList.add('countdown-card--concluded');
        if (rsvpBtn) {
          rsvpBtn.textContent = 'Join OCG Group';
          rsvpBtn.setAttribute('href', 'https://ocgroups.dev/cncf/group/6vwk2n4');
        }
        if (intervalId) clearInterval(intervalId);
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      if (daysEl) daysEl.innerText = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.innerText = String(hours).padStart(2, '0');
      if (minsEl) minsEl.innerText = String(mins).padStart(2, '0');
      if (secsEl) secsEl.innerText = String(secs).padStart(2, '0');
    }

    update();
    intervalId = window.setInterval(update, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCountdown);
  } else {
    initCountdown();
  }
  document.addEventListener('astro:page-load', initCountdown);
</script>
