---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const team = await getCollection('team');
const events = await getCollection('events');
---

<section class="hero section">
  <div class="container">
    <div class="hero__badge-row">
      <span class="badge badge--live">Official CNCF Chapter</span>
      <span class="badge">Peshawar, Pakistan</span>
    </div>

    <h1 class="hero__title">Cloud Native Peshawar</h1>

    <p class="hero__lede">
      Empowering the next generation of cloud native engineers in Pakistan through hands-on technical community sessions, open source contributions, and deep architectural exploration.
    </p>

    <!-- Key Stats Row -->
    <div class="hero__stats">
      <div class="hero__stat">
        <span class="material-symbols-outlined">groups</span>
        <span>{team.length}+ Organizers &amp; Volunteers</span>
      </div>
      <span class="hero__stat-sep">•</span>
      <div class="hero__stat">
        <span class="material-symbols-outlined">terminal</span>
        <span>{events.length}+ Sessions Delivered</span>
      </div>
      <span class="hero__stat-sep">•</span>
      <div class="hero__stat">
        <span class="material-symbols-outlined">code_blocks</span>
        <span>Open Source</span>
      </div>
    </div>

    <!-- Primary Action Buttons -->
    <div class="hero__actions">
      <a href={`${base}/events`} class="btn btn--accent">
        <span>Upcoming Events</span>
        <span class="material-symbols-outlined">calendar_month</span>
      </a>
      <a href={`${base}/about`} class="btn btn--secondary">
        <span>Read the Genesis Recap</span>
        <span class="material-symbols-outlined">arrow_forward</span>
      </a>
    </div>

    <!-- Telemetry Status Bar -->
    <div class="hero__telemetry">
      <div class="hero__telemetry-items">
        <span class="hero__telemetry-item">
          <span class="hero__telemetry-dot hero__telemetry-dot--accent"></span>
          KUBERNETES
        </span>
        <span class="hero__telemetry-item">
          <span class="hero__telemetry-dot hero__telemetry-dot--secondary"></span>
          PROMETHEUS
        </span>
        <span class="hero__telemetry-item">
          <span class="hero__telemetry-dot"></span>
          NIC PESHAWAR HQ
        </span>
      </div>
      <span class="hero__telemetry-region">REGIONAL CHAPTER • KHYBER PAKHTUNKHWA</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .hero__badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .hero__title {
    font-size: var(--font-size-5xl);
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
    max-width: 16ch;
  }

  .hero__lede {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-ink-muted);
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }

  .hero__stat {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .hero__stat .material-symbols-outlined {
    font-size: 18px;
    color: var(--color-accent);
  }

  .hero__stat-sep {
    color: var(--color-ink-subtle);
    opacity: 0.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .hero__actions .material-symbols-outlined {
    font-size: 18px;
  }

  .hero__telemetry {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
  }

  .hero__telemetry-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__telemetry-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hero__telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-signal-green);
  }

  .hero__telemetry-dot--accent {
    background-color: var(--color-accent);
  }

  .hero__telemetry-dot--secondary {
    background-color: var(--color-signal-green);
  }
</style>
