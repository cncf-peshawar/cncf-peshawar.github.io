---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = '' } = Astro.props;
---

<svg 
  width={size} 
  height={size} 
  viewBox="0 0 28 28" 
  fill="none" 
  stroke="currentColor" 
  stroke-width="2" 
  stroke-linecap="round" 
  stroke-linejoin="round"
  class={className} 
  aria-hidden="true"
>
  <!-- Geometric Innovation Hub icon (Hexagon + Central Node) -->
  <polygon points="14 2 24 8 24 20 14 26 4 20 4 8 14 2" fill="none" />
  <circle cx="14" cy="14" r="3.5" fill="currentColor" stroke="none" />
  <line x1="14" y1="2" x2="14" y2="10.5" />
  <line x1="14" y1="17.5" x2="14" y2="26" />
  <line x1="4" y1="8" x2="11" y2="12" />
  <line x1="17" y1="16" x2="24" y2="20" />
  <line x1="4" y1="20" x2="11" y2="16" />
  <line x1="17" y1="12" x2="24" y2="8" />
</svg>
