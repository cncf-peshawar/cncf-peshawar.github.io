---
const verifiableFacts = [
  {
    badge: "ACCESS",
    title: "100% Free & Open",
    desc: "Zero ticket costs, paywalls, or membership fees for all meetups and workshops."
  },
  {
    badge: "AFFILIATION",
    title: "Official CNCF Chapter",
    desc: "Recognized community group under the Cloud Native Computing Foundation & Linux Foundation."
  },
  {
    badge: "MISSION",
    title: "Hands-On & Practical",
    desc: "Focused on open-source cloud architectures, Kubernetes, containers, and Linux systems."
  },
  {
    badge: "COLLABORATION",
    title: "Open Community",
    desc: "Open to developers, DevOps engineers, university students, and community partners."
  }
];
---

<section class="stats-strip section--subtle">
  <div class="container">
    <h2 class="sr-only">Key Community Facts & Verifiable Commitments</h2>
    <div class="facts-grid">
      {verifiableFacts.map((fact) => (
        <div class="fact-item">
          <span class="fact-item__badge">{fact.badge}</span>
          <h3 class="fact-item__title">{fact.title}</h3>
          <p class="fact-item__desc">{fact.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-strip {
    padding-block: var(--space-xl);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 600px) {
    .facts-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 1024px) {
    .facts-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-md);
    }
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .fact-item:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .fact-item__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .fact-item__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    margin-bottom: var(--space-3xs);
    line-height: var(--line-height-snug);
  }

  .fact-item__desc {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: var(--line-height-normal);
  }
</style>
