---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'textarea'> {
  label?: string;
  id?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  error?: string;
  helper?: string;
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  label,
  id,
  name,
  value,
  placeholder,
  rows = 4,
  error,
  helper,
  required = false,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const textareaId = id || (name ? `textarea-${name}` : undefined);
const errorId = textareaId && error ? `${textareaId}-error` : undefined;
const helperId = textareaId && helper ? `${textareaId}-helper` : undefined;
const describedBy = [errorId, helperId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  {label && (
    <label for={textareaId} class="field__label">
      {label}
      {required && <span class="field__required" aria-hidden="true">*</span>}
    </label>
  )}

  <textarea
    id={textareaId}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    class:list={['field__textarea', error && 'field__textarea--error', className]}
    {...rest}
  >{value || ''}<slot /></textarea>

  {error && (
    <span id={errorId} class="field__message field__message--error" role="alert">
      {error}
    </span>
  )}

  {helper && !error && (
    <span id={helperId} class="field__message field__message--helper">
      {helper}
    </span>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6, 6px);
    width: 100%;
  }

  .field__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption, 0.75rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide, 0.02em);
    text-transform: uppercase;
    user-select: none;
  }

  .field__required {
    color: var(--color-coral-sketch);
    margin-left: 2px;
  }

  .field__textarea {
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
    font-family: var(--font-mono);
    font-size: var(--font-size-body, 0.875rem);
    line-height: var(--line-height-normal, 1.4);
    padding: 10px 14px;
    border: var(--border-width, 2px) solid var(--color-charcoal-ink);
    border-radius: var(--radius-brutal);
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-fast, 0.1s ease);
    resize: vertical;
    min-height: 80px;
    -webkit-appearance: none;
    appearance: none;
  }

  .field__textarea::placeholder {
    color: var(--color-pencil-gray);
    font-family: var(--font-mono);
    opacity: 1;
  }

  .field__textarea:focus-visible {
    outline: 3px solid var(--color-charcoal-ink);
    outline-offset: 3px;
  }

  .field__textarea:disabled {
    background-color: var(--color-chalk-gray);
    border-color: var(--color-pencil-gray);
    color: var(--color-text-disabled);
    cursor: not-allowed;
  }

  .field__textarea--error {
    border-color: var(--color-coral-sketch);
  }

  .field__message {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption, 0.75rem);
    line-height: var(--line-height-tight, 1.2);
  }

  .field__message--error {
    color: var(--color-coral-sketch);
    font-weight: var(--font-weight-medium, 500);
  }

  .field__message--helper {
    color: var(--color-text-muted);
  }
</style>
