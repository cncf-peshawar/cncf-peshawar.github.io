---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  variant?:
    | 'coral'
    | 'peach'
    | 'mint'
    | 'lilac'
    | 'lime'
    | 'periwinkle'
    | 'slate'
    | 'marigold'
    | 'charcoal'
    | 'canary'
    | 'orange'
    | 'sky';
  color?:
    | 'coral'
    | 'peach'
    | 'mint'
    | 'lilac'
    | 'lime'
    | 'periwinkle'
    | 'slate'
    | 'marigold'
    | 'charcoal'
    | 'canary'
    | 'orange'
    | 'sky';
  fill?: boolean;
  active?: boolean;
  interactive?: boolean;
  as?: 'span' | 'a' | 'button';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  variant,
  color,
  fill = false,
  active = false,
  interactive = false,
  as: Component = 'span',
  class: className = '',
  ...rest
} = Astro.props;

const selectedColor = color || variant;
const colorClass = selectedColor ? `tag--${selectedColor}` : 'tag--cycle';
---

<Component
  class:list={[
    'tag',
    colorClass,
    fill && 'tag--fill',
    active && 'tag--active',
    interactive && 'tag--interactive',
    className
  ]}
  {...rest}
>
  <slot />
</Component>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-4, 4px);
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    line-height: var(--line-height-snug, 1.2);
    letter-spacing: var(--letter-spacing-normal, 0.02em);
    padding: 4px 10px;
    border-radius: var(--radius-brutal);
    border-width: var(--border-width, 2px);
    border-style: solid;
    border-color: var(--color-charcoal-ink);
    white-space: nowrap;
    user-select: none;
    vertical-align: middle;
    text-decoration: none;
  }

  a.tag {
    text-decoration: none;
    color: inherit;
  }

  /* Specific color borders */
  .tag--coral { border-color: var(--color-coral-sketch); }
  .tag--peach { border-color: var(--color-peach-sketch); }
  .tag--mint { border-color: var(--color-mint-sketch); }
  .tag--lilac { border-color: var(--color-lilac-sketch); }
  .tag--lime { border-color: var(--color-lime-sketch); }
  .tag--periwinkle { border-color: var(--color-periwinkle-sketch); }
  .tag--slate { border-color: var(--color-slate-sketch); }
  .tag--marigold { border-color: var(--color-marigold-sketch); }
  .tag--charcoal { border-color: var(--color-charcoal-ink); }
  .tag--canary { border-color: var(--color-canary-banner); }
  .tag--orange { border-color: var(--color-duck-bill-orange); }
  .tag--sky { border-color: var(--color-sky-crayon); }

  /* Filled background variants */
  .tag--fill.tag--coral { background-color: var(--color-coral-sketch); }
  .tag--fill.tag--peach { background-color: var(--color-peach-sketch); }
  .tag--fill.tag--mint { background-color: var(--color-mint-sketch); }
  .tag--fill.tag--lilac { background-color: var(--color-lilac-sketch); }
  .tag--fill.tag--lime { background-color: var(--color-lime-sketch); }
  .tag--fill.tag--periwinkle { background-color: var(--color-periwinkle-sketch); }
  .tag--fill.tag--slate { background-color: var(--color-slate-sketch); }
  .tag--fill.tag--marigold { background-color: var(--color-marigold-sketch); }
  .tag--fill.tag--canary { background-color: var(--color-canary-banner); }
  .tag--fill.tag--orange { background-color: var(--color-duck-bill-orange); }
  .tag--fill.tag--sky { background-color: var(--color-sky-crayon); }

  /* Active / Selected state */
  .tag--active {
    background-color: var(--color-charcoal-ink) !important;
    color: var(--color-frost-white) !important;
    border-color: var(--color-charcoal-ink) !important;
  }

  /* Interactive hover */
  .tag--interactive {
    cursor: pointer;
    transition: transform var(--transition-fast, 0.1s ease), box-shadow var(--transition-fast, 0.1s ease);
  }

  .tag--interactive:hover {
    transform: translate(2px, -2px);
    box-shadow: -2px 2px 0px 0px var(--color-charcoal-ink);
  }

  .tag--interactive:active {
    transform: none;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag--interactive,
    .tag--interactive:hover,
    .tag--interactive:active {
      transform: none !important;
      transition: none !important;
    }
  }

  /* Automatic cycling across the 8 sketch colors */
  .tag--cycle:nth-of-type(8n + 1) { border-color: var(--color-coral-sketch); }
  .tag--cycle:nth-of-type(8n + 2) { border-color: var(--color-peach-sketch); }
  .tag--cycle:nth-of-type(8n + 3) { border-color: var(--color-mint-sketch); }
  .tag--cycle:nth-of-type(8n + 4) { border-color: var(--color-lilac-sketch); }
  .tag--cycle:nth-of-type(8n + 5) { border-color: var(--color-lime-sketch); }
  .tag--cycle:nth-of-type(8n + 6) { border-color: var(--color-periwinkle-sketch); }
  .tag--cycle:nth-of-type(8n + 7) { border-color: var(--color-slate-sketch); }
  .tag--cycle:nth-of-type(8n + 8) { border-color: var(--color-marigold-sketch); }
</style>
