---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'canary' | 'rainbow';
  size?: 'sm' | 'md' | 'lg';
  rainbowColor?: 'coral' | 'peach' | 'mint' | 'lilac' | 'lime' | 'periwinkle' | 'slate' | 'marigold';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  rainbowColor,
  type = 'button',
  class: className = '',
  disabled = false,
  ...rest
} = Astro.props;

const activeVariant = variant === 'outline' ? 'secondary' : variant;

const rainbowClass = activeVariant === 'rainbow'
  ? rainbowColor
    ? `btn--rainbow-${rainbowColor}`
    : 'btn--rainbow-cycle'
  : undefined;
---

<button
  type={type}
  class:list={['btn', `btn--${activeVariant}`, `btn--${size}`, rainbowClass, className]}
  disabled={disabled}
  {...rest}
>
  <slot />
</button>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8, 8px);
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium, 500);
    line-height: var(--line-height-snug, 1.2);
    letter-spacing: var(--letter-spacing-normal, 0.02em);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-brutal);
    border-width: var(--border-width, 2px);
    border-style: solid;
    box-shadow: var(--shadow-hard, -6px 6px 0px 0px var(--color-charcoal-ink));
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: transform 120ms ease-in-out;
    -webkit-font-smoothing: antialiased;
  }

  .btn:hover:not(:disabled) {
    transform: translate(7px, -7px);
    transition: transform 120ms ease-in-out;
  }

  .btn:active:not(:disabled) {
    transform: none;
    transition: transform 30ms ease-in-out;
  }

  .btn:focus-visible {
    outline: 3px solid var(--color-charcoal-ink);
    outline-offset: 3px;
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
    box-shadow: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn:hover:not(:disabled),
    .btn:active:not(:disabled) {
      transform: none !important;
      transition: none !important;
    }
  }

  /* Sizes */
  .btn--sm {
    padding: 6px 14px;
    font-size: var(--font-size-caption, 0.75rem);
    min-height: 32px;
  }

  .btn--md {
    padding: 10px 24px;
    font-size: var(--font-size-body, 0.875rem);
    min-height: 44px;
  }

  .btn--lg {
    padding: 14px 32px;
    font-size: var(--font-size-body-lg, 1rem);
    min-height: 52px;
  }

  /* Variants */
  .btn--primary {
    background-color: var(--color-sky-crayon);
    color: var(--color-charcoal-ink);
    border-color: var(--color-charcoal-ink);
  }

  .btn--primary:hover:not(:disabled) {
    background-color: var(--color-sky-crayon);
  }

  .btn--secondary {
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
    border-color: var(--color-charcoal-ink);
  }

  .btn--secondary:hover:not(:disabled) {
    background-color: var(--color-ice-wash);
  }

  .btn--canary {
    background-color: var(--color-canary-banner);
    color: var(--color-charcoal-ink);
    border-color: var(--color-charcoal-ink);
  }

  .btn--canary:hover:not(:disabled) {
    background-color: var(--color-canary-banner);
  }

  .btn--rainbow {
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
    border-color: var(--color-coral-sketch);
  }

  .btn--rainbow:hover:not(:disabled) {
    background-color: var(--color-ice-wash);
  }

  /* Rainbow explicit color slots */
  .btn--rainbow-coral { border-color: var(--color-coral-sketch); }
  .btn--rainbow-peach { border-color: var(--color-peach-sketch); }
  .btn--rainbow-mint { border-color: var(--color-mint-sketch); }
  .btn--rainbow-lilac { border-color: var(--color-lilac-sketch); }
  .btn--rainbow-lime { border-color: var(--color-lime-sketch); }
  .btn--rainbow-periwinkle { border-color: var(--color-periwinkle-sketch); }
  .btn--rainbow-slate { border-color: var(--color-slate-sketch); }
  .btn--rainbow-marigold { border-color: var(--color-marigold-sketch); }

  /* Rainbow cycling */
  .btn--rainbow-cycle:nth-of-type(8n + 1) { border-color: var(--color-coral-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 2) { border-color: var(--color-peach-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 3) { border-color: var(--color-mint-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 4) { border-color: var(--color-lilac-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 5) { border-color: var(--color-lime-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 6) { border-color: var(--color-periwinkle-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 7) { border-color: var(--color-slate-sketch); }
  .btn--rainbow-cycle:nth-of-type(8n + 8) { border-color: var(--color-marigold-sketch); }
</style>
