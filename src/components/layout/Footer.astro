<style>
  .site-footer {
    width: 100%;
    background-color: var(--color-frost-white);
    border-top: 1px solid var(--color-charcoal-ink);
    padding: var(--spacing-40) var(--spacing-24) var(--spacing-24);
    margin-top: auto;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .footer-statement {
    padding-bottom: var(--spacing-24);
    border-bottom: 1px solid var(--color-graphite);
    margin-bottom: var(--spacing-32);
  }

  .footer-headline {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-charcoal-ink);
    line-height: var(--line-height-snug);
    margin-bottom: var(--spacing-4);
  }

  .footer-subheadline {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-32);
    margin-bottom: var(--spacing-40);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-40);
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-charcoal-ink);
    margin-bottom: var(--spacing-12);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-charcoal-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-sky-crayon);
    text-underline-offset: 2px;
  }

  .footer-contact-desc {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-8);
  }

  .footer-email {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: var(--font-weight-bold);
    color: var(--color-charcoal-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-sky-crayon);
    text-underline-offset: 3px;
    margin-bottom: var(--spacing-16);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-social-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    margin-top: var(--spacing-4);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    min-height: 44px;
    min-width: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    background-color: var(--color-chalk-gray);
    border: 2px solid var(--color-charcoal-ink);
    border-radius: var(--radius-brutal);
    color: var(--color-charcoal-ink);
    text-decoration: none;
    text-transform: uppercase;
  }

  .social-btn:hover {
    background-color: var(--color-sky-crayon);
  }

  .social-icon {
    width: 20px;
    height: 20px;
    display: block;
    flex-shrink: 0;
  }

  .footer-bottom-bar {
    padding-top: var(--spacing-20);
    border-top: 1px solid var(--color-graphite);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-legal {
    margin: 0;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .footer-meta a {
    color: var(--color-charcoal-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-sky-crayon);
    text-underline-offset: 2px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-meta-sep {
    color: var(--color-text-muted);
  }

  /* Focus-visible: 3px solid charcoal, 3px offset per CTO §4.4 */
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--color-charcoal-ink);
    outline-offset: 3px;
  }
</style>
