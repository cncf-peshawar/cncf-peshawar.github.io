---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title = "Cloud Native Peshawar — Official CNCF Community Group",
  description = "Compiling the future of Peshawar's tech ecosystem, one container at a time. Empowering engineers, students, and companies with Kubernetes, DevOps, MLOps, and Agentic AI.",
  image = `${base}/images/og-default.svg`
} = Astro.props;

const siteUrl = Astro.site || new URL('https://cncf-peshawar.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imageURL = new URL(image, siteUrl);
const fullTitle = title.includes("Cloud Native Peshawar") || title.includes("CNCF Peshawar") 
  ? title 
  : `${title} | Cloud Native Peshawar`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/images/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}/images/favicon-64.png`} />
    <link rel="apple-touch-icon" sizes="256x256" href={`${base}/images/favicon-256.png`} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efea" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cloud Native Peshawar" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <!-- Reticle Verification (local only) -->
    <script is:inline>
      if (typeof window !== 'undefined' && (location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
        import('https://cdn.jsdelivr.net/npm/@reticlehq/browser@latest/+esm')
          .then(({ reticle }) => {
            reticle.connect({ token: '951a55df63f79bf5b3b7b3baac307f5de6848ed1d683af96' });
          })
          .catch(() => {});
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header currentPath={canonicalURL.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  #main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
