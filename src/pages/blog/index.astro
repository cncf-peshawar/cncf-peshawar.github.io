---
import { getCollection } from 'astro:content';
import Marquee from '../../components/ui/Marquee.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout 
  title="Blog & Community Recaps | CNCF Peshawar" 
  description="Read official announcements, workshop recaps, and technical cloud native tutorials from CNCF Peshawar."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <div class="page-hero__copy">
        <div class="page-hero__eyebrow" data-hero-eyebrow>
          <span class="badge badge--mint">00 // RECAPS &amp; ARTICLES</span>
          <span class="eyebrow-text">COMMUNITY PUBLICATIONS</span>
        </div>
        <h1 class="page-hero__title">Blog &amp; Community Recaps.</h1>
        <p class="page-hero__desc" data-hero-lede>
          Official announcements, workshop recaps, and technical cloud-native tutorials written by CNCF Peshawar organizers and community contributors.
        </p>
      </div>
      <div class="blog-hero-doodle" data-hero-doodle aria-hidden="true">
        <svg viewBox="0 0 156 150" fill="none" aria-hidden="true">
          <path d="M24 32 C40 22 77 25 92 30 L92 121 C74 115 41 116 24 124 Z" fill="var(--color-frost-white)" stroke="var(--color-charcoal-ink)" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M92 30 C108 23 130 25 140 30 L140 122 C123 116 108 117 92 121 Z" fill="var(--color-notebook-pale)" stroke="var(--color-charcoal-ink)" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M92 31 L92 120" stroke="var(--color-wet-cement)" stroke-width="2" stroke-dasharray="5 4"/>
          <path d="M35 48 C48 44 64 44 80 48 M35 61 C49 58 66 57 80 60 M35 74 C47 71 64 70 79 74 M104 48 C112 45 123 45 132 48 M104 61 C114 58 123 58 132 61 M104 74 C113 72 124 72 132 74" stroke="var(--color-wet-cement)" stroke-width="2" stroke-linecap="round"/>
          <path d="M42 96 C53 90 62 89 72 95 C63 103 53 105 42 96 Z" fill="var(--color-canary-banner)" stroke="var(--color-charcoal-ink)" stroke-width="2"/>
          <path d="M106 97 C113 91 123 92 131 98" stroke="var(--color-duck-bill-orange)" stroke-width="3" stroke-linecap="round"/>
          <path d="M14 20 L9 13 M19 14 L19 6 M139 15 L147 8 M145 24 L152 22" stroke="var(--color-charcoal-ink)" stroke-width="2" stroke-linecap="round"/>
          <circle cx="121" cy="103" r="3" fill="var(--color-duck-bill-orange)"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="section-wrap">
    <div class="posts-grid" data-reveal-group>
      {publishedPosts.map((post, idx) => {
        const postDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        });
        const borderColors = ['coral', 'mint', 'periwinkle', 'peach', 'lilac'];
        const borderColor = borderColors[idx % borderColors.length];

        return (
          <article class={`post-card brutal-card post-card--${borderColor}`} data-reveal-item>
            <div class="post-card__header">
              <span class="post-card__date">{postDate}</span>
              <span class="badge badge--white post-card__author">by {post.data.author} ({post.data.authorRole})</span>
            </div>

            <h2 class="post-card__title">
              <a href={`${base}/blog/${post.slug}`}>{post.data.title}</a>
            </h2>

            <p class="post-card__desc">{post.data.description}</p>

            <div class="post-card__footer">
              <div class="post-card__tags">
                {post.data.tags.map((t, tIdx) => {
                  const tagColors = ['yellow', 'live', 'mint', 'orange'];
                  const tagColor = tagColors[tIdx % tagColors.length];
                  return <span class={`badge badge--${tagColor}`}>#{t}</span>;
                })}
              </div>

              <a href={`${base}/blog/${post.slug}`} class="btn btn--outline btn--sm post-card__link">
                <span>Read Article →</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <Marquee label="Blog Community Topics Marquee" speed="25s" items={["KUBERNETES", "DEVOPS", "MLOPS", "DISTRIBUTED SYSTEMS", "AGENTIC AI", "100% FREE COMMUNITY", "OPEN TO ALL BUILDERS", "KHYBER PAKHTUNKHWA"]} />
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ */
  /* HERO STYLES                                                        */
  /* ------------------------------------------------------------------ */
  .page-hero {
    padding-top: var(--spacing-80);
    padding-bottom: var(--spacing-80);
    padding-inline: var(--spacing-32);
    background-color: var(--color-cream-paper);
    border-bottom: var(--border-width, 2px) solid var(--color-charcoal-ink);
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: var(--spacing-40);
      padding-bottom: var(--spacing-60);
      padding-inline: var(--spacing-16);
    }
  }

  .page-hero__inner {
    max-width: var(--page-max-width);
    margin: 0 auto;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(110px, 156px);
    align-items: center;
    gap: clamp(16px, 4vw, 48px);
  }

  .blog-hero-doodle {
    width: 100%;
    pointer-events: none;
  }

  .blog-hero-doodle svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .page-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-16, 16px);
    }

    .blog-hero-doodle {
      width: 96px;
      justify-self: end;
    }
  }

  .page-hero__eyebrow {
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-16);
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .eyebrow-text {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .page-hero__title {
    font-family: var(--font-mono);
    font-size: var(--font-size-display);
    font-weight: 700;
    line-height: var(--line-height-snug);
    letter-spacing: -0.02em;
    color: var(--color-charcoal-ink);
    margin-bottom: var(--spacing-20);
    text-transform: uppercase;
  }

  .page-hero__desc {
    font-family: var(--font-mono);
    font-size: var(--font-size-subheading);
    color: var(--color-charcoal-ink);
    max-width: var(--container-prose);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* ------------------------------------------------------------------ */
  /* SECTION WRAP & POSTS GRID                                          */
  /* ------------------------------------------------------------------ */
  .section-wrap {
    padding: var(--spacing-60) var(--spacing-24);
    max-width: var(--page-max-width);
    margin: 0 auto;
    position: relative;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
  }

  /* ------------------------------------------------------------------ */
  /* POST CARDS                                                         */
  /* ------------------------------------------------------------------ */
  .brutal-card {
    background: var(--color-frost-white);
    border: 2px solid var(--color-charcoal-ink);
    border-radius: var(--radius-brutal);
    box-shadow: var(--shadow-hard-sm);
    padding: var(--spacing-28, 28px);
    position: relative;
    transition: transform 200ms ease-in-out, box-shadow 200ms ease-in-out;
  }

  .post-card {
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translate(3px, -3px) !important;
    box-shadow: var(--shadow-hard);
  }

  .post-card:active {
    transform: none !important;
    transition: transform 30ms ease-in-out;
  }

  .post-card--coral {
    border-left: var(--border-accent-width, 6px) solid var(--color-coral-sketch);
  }

  .post-card--mint {
    border-left: var(--border-accent-width, 6px) solid var(--color-mint-sketch);
  }

  .post-card--periwinkle {
    border-left: var(--border-accent-width, 6px) solid var(--color-periwinkle-sketch);
  }

  .post-card--peach {
    border-left: var(--border-accent-width, 6px) solid var(--color-peach-sketch);
  }

  .post-card--lilac {
    border-left: var(--border-accent-width, 6px) solid var(--color-lilac-sketch);
  }

  .post-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-12);
    flex-wrap: wrap;
    gap: var(--spacing-8);
  }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .post-card__author {
    font-size: var(--font-size-caption);
  }

  .post-card__title {
    font-family: var(--font-mono);
    font-size: var(--font-size-heading-sm);
    font-weight: 700;
    line-height: var(--line-height-snug);
    margin-bottom: var(--spacing-8);
    color: var(--color-charcoal-ink);
  }

  .post-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.1s ease;
  }

  .post-card__title a:hover {
    color: var(--color-sky-crayon);
    text-decoration: underline;
  }

  .post-card__title a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .post-card__desc {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    color: var(--color-charcoal-ink);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-20);
    max-width: var(--container-prose);
  }

  .post-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-12);
    margin-top: auto;
    padding-top: var(--spacing-12);
    border-top: 1px solid var(--color-chalk-gray);
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-6, 6px);
  }

  /* ------------------------------------------------------------------ */
  /* BADGES & BUTTONS                                                   */
  /* ------------------------------------------------------------------ */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-6, 6px);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-brutal);
    border: 1px solid var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
  }

  .badge--white {
    background: var(--color-frost-white);
    color: var(--color-charcoal-ink);
  }

  .badge--mint {
    background: var(--color-mint-sketch);
    color: var(--color-charcoal-ink);
  }

  .badge--yellow {
    background: var(--color-canary-banner);
    color: var(--color-charcoal-ink);
  }

  .badge--live {
    background: var(--color-ice-wash);
    color: var(--color-charcoal-ink);
  }

  .badge--orange {
    background: var(--color-duck-bill-orange);
    color: var(--color-charcoal-ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: 600;
    padding: 11px 22px;
    border-radius: var(--radius-brutal);
    border: 2px solid var(--color-charcoal-ink);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    box-shadow: var(--shadow-hard, -6px 6px 0px 0px var(--color-charcoal-ink));
    transition: transform 120ms ease-in-out;
    user-select: none;
    min-height: 44px;
    box-sizing: border-box;
  }

  .btn:hover {
    transform: translate(7px, -7px) !important;
  }

  .btn:active {
    transform: none !important;
    transition: transform 30ms ease-in-out !important;
  }

  .btn:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .btn--outline {
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
  }

  .btn--sm {
    padding: 7px 14px;
    font-size: var(--font-size-caption);
    min-height: 44px;
  }

  /* ------------------------------------------------------------------ */
  /* PREFERS-REDUCED-MOTION (PRM)                                       */
  /* ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .btn:hover, .post-card:hover {
      transform: none !important;
    }
  }
</style>
