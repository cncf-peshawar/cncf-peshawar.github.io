---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await post.render();

const postDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});
---

<BaseLayout title={`${data.title} | CNCF Peshawar`} description={data.description}>
  <!-- Top Breadcrumb & Back Link -->
  <div class="breadcrumb-container" data-reveal>
    <div class="breadcrumb-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}>Home</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog`}>Blog</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog`} class="btn btn--outline btn--sm back-nav-btn">
        <span aria-hidden="true">←</span> Back to All Articles
      </a>
    </div>
  </div>

  <!-- Article Header / Hero -->
  <section class="page-hero" data-reveal>
    <div class="page-hero__inner">
      <div class="page-hero__eyebrow">
        <span class="badge badge--yellow">ANNOUNCEMENT</span>
        <span class="eyebrow-text">{postDate}</span>
      </div>
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <div class="author-avatar" aria-hidden="true">
          {data.author.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase()}
        </div>
        <div class="author-info">
          <span class="author-name">{data.author}</span>
          <span class="author-role">{data.authorRole}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Prose Article Body -->
  <article class="section-wrap" data-reveal>
    <div class="prose prose--article">
      <Content />
    </div>

    <div class="back-row">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog`} class="btn btn--outline back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Back to All Articles</span>
      </a>
    </div>
  </article>

  <!-- Marquee Strip -->
  <div class="marquee-container" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>KUBERNETES</span><span>·</span>
        <span>DEVOPS</span><span>·</span>
        <span>MLOPS</span><span>·</span>
        <span>DISTRIBUTED SYSTEMS</span><span>·</span>
        <span>AGENTIC AI</span><span>·</span>
        <span>100% FREE COMMUNITY</span><span>·</span>
        <span>OPEN TO ALL BUILDERS</span><span>·</span>
        <span>KHYBER PAKHTUNKHWA</span><span>·</span>
      </div>
      <div class="marquee-content">
        <span>KUBERNETES</span><span>·</span>
        <span>DEVOPS</span><span>·</span>
        <span>MLOPS</span><span>·</span>
        <span>DISTRIBUTED SYSTEMS</span><span>·</span>
        <span>AGENTIC AI</span><span>·</span>
        <span>100% FREE COMMUNITY</span><span>·</span>
        <span>OPEN TO ALL BUILDERS</span><span>·</span>
        <span>KHYBER PAKHTUNKHWA</span><span>·</span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @import '../../styles/prose.css';

  /* ------------------------------------------------------------------ */
  /* BREADCRUMB & TOP NAV                                               */
  /* ------------------------------------------------------------------ */
  .breadcrumb-container {
    background-color: var(--color-cream-paper);
    padding: var(--spacing-20) var(--spacing-24) 0;
  }

  .breadcrumb-inner {
    max-width: var(--page-max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-16);
    flex-wrap: wrap;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-charcoal-ink);
    text-decoration: none;
    font-weight: 500;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb .sep {
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------------ */
  /* ARTICLE HERO                                                       */
  /* ------------------------------------------------------------------ */
  .page-hero {
    padding: var(--spacing-48) var(--spacing-24) var(--spacing-48);
    background-color: var(--color-cream-paper);
    border-bottom: 2px solid var(--color-charcoal-ink);
    position: relative;
  }

  .page-hero__inner {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  .page-hero__eyebrow {
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-12);
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .eyebrow-text {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .post-title {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: var(--line-height-snug);
    letter-spacing: -0.02em;
    color: var(--color-charcoal-ink);
    margin-bottom: var(--spacing-16);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
    margin-top: var(--spacing-16);
  }

  .author-avatar {
    width: 38px;
    height: 38px;
    background-color: var(--color-sky-crayon);
    border: 2px solid var(--color-charcoal-ink);
    border-radius: var(--radius-brutal);
    box-shadow: var(--shadow-hard-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--font-size-caption);
    color: var(--color-charcoal-ink);
    flex-shrink: 0;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-charcoal-ink);
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
  }

  /* ------------------------------------------------------------------ */
  /* SECTION WRAP & PROSE                                               */
  /* ------------------------------------------------------------------ */
  .section-wrap {
    padding: var(--spacing-60) var(--spacing-24);
    max-width: var(--page-max-width);
    margin: 0 auto;
    position: relative;
  }

  .back-row {
    margin-top: var(--spacing-48);
    display: flex;
    justify-content: center;
    max-width: 720px;
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  /* ------------------------------------------------------------------ */
  /* BADGES & BUTTONS                                                   */
  /* ------------------------------------------------------------------ */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-6, 6px);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-brutal);
    border: 1px solid var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
  }

  .badge--yellow {
    background: var(--color-canary-banner);
    color: var(--color-charcoal-ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: 600;
    padding: 11px 22px;
    border-radius: var(--radius-brutal);
    border: 2px solid var(--color-charcoal-ink);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    box-shadow: var(--shadow-hard-sm);
    transition: transform 120ms ease-in-out, box-shadow 120ms ease-in-out;
    user-select: none;
    min-height: 44px;
    box-sizing: border-box;
  }

  .btn:hover {
    transform: translate(7px, -7px);
    box-shadow: var(--shadow-hard);
  }

  .btn:active {
    transform: none;
    transition: transform 30ms;
  }

  .btn:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .btn--outline {
    background-color: var(--color-frost-white);
    color: var(--color-charcoal-ink);
  }

  .btn--sm {
    padding: 7px 14px;
    font-size: var(--font-size-caption);
    min-height: 44px;
  }

  /* ------------------------------------------------------------------ */
  /* MARQUEE STRIP                                                      */
  /* ------------------------------------------------------------------ */
  .marquee-container {
    width: 100%;
    background: var(--color-canary-banner);
    border-top: 2px solid var(--color-charcoal-ink);
    border-bottom: 2px solid var(--color-charcoal-ink);
    overflow: hidden;
    padding: 10px 0;
    white-space: nowrap;
    user-select: none;
  }

  .marquee-track {
    display: inline-flex;
    animation: marqueeScroll 25s linear infinite;
  }

  .marquee-content {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-24);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    color: var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    padding-right: var(--spacing-24);
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ------------------------------------------------------------------ */
  /* PREFERS-REDUCED-MOTION (PRM)                                       */
  /* ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .marquee-track {
      animation: none !important;
    }
    .btn:hover {
      transform: none !important;
    }
  }
</style>
