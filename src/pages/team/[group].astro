---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildWorkingGroups, getAvatarSrc as getAvatarSrcBase, initials } from '../../lib/team';

export async function getStaticPaths() {
  const allTeam = await getCollection('team');
  const sortedTeam = allTeam.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
  const groups = buildWorkingGroups(sortedTeam);

  return groups.map((group) => ({
    params: { group: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getAvatarSrc = (avatar?: string) => getAvatarSrcBase(base, avatar);
---

<BaseLayout
  title={`${group.title} | CNCF Peshawar Team`}
  description={`Meet the ${group.members.length} volunteers on the CNCF Peshawar ${group.title}. ${group.desc}`}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb container">
    <a href={`${base}/`}>Home</a>
    <span>/</span>
    <a href={`${base}/team`}>Team</a>
    <span>/</span>
    <span>{group.title}</span>
  </div>

  <!-- Group Header -->
  <section class="page-header section">
    <div class="container">
      <div class="group-header">
        <div class="group-header__icon"><span class="material-symbols-outlined">{group.icon}</span></div>
        <div>
          <span class="group-header__code">{group.code}</span>
          <h1 class="page-header__title">{group.title}</h1>
        </div>
      </div>
      <p class="page-header__desc">{group.desc}</p>
      <span class="badge badge--live">{group.members.length} Member{group.members.length === 1 ? '' : 's'}</span>
    </div>
  </section>

  <!-- Member Grid -->
  <section class="section section--subtle">
    <div class="container">
      <div class="member-grid">
        {group.members.map((member) => (
          <div class="member-card">
            <div class="member-card__avatar">
              {member.data.avatar ? (
                <img src={getAvatarSrc(member.data.avatar)} alt={member.data.name} loading="lazy" />
              ) : (
                <span class="member-card__initials">{initials(member.data.name)}</span>
              )}
            </div>
            <div class="member-card__body">
              <h3 class="member-card__name">{member.data.name}</h3>
              <p class="member-card__role">{member.data.role}</p>
              {(member.data.university || member.data.company) && (
                <p class="member-card__org">{member.data.university || member.data.company}</p>
              )}
              {member.data.bio && <p class="member-card__bio">{member.data.bio}</p>}
              <div class="member-card__links">
                {member.data.github && (
                  <a href={member.data.github} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} on GitHub`}>
                    <span class="material-symbols-outlined">code</span>
                  </a>
                )}
                {member.data.linkedin && (
                  <a href={member.data.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} on LinkedIn`}>
                    <span class="material-symbols-outlined">business_center</span>
                  </a>
                )}
                {member.data.twitter && (
                  <a href={member.data.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} on X / Twitter`}>
                    <span class="material-symbols-outlined">alternate_email</span>
                  </a>
                )}
                {member.data.email && (
                  <a href={`mailto:${member.data.email}`} aria-label={`Email ${member.data.name}`}>
                    <span class="material-symbols-outlined">mail</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="back-link-row">
        <a href={`${base}/team`} class="back-link">
          <span class="material-symbols-outlined">arrow_back</span>
          <span>Back to All Team &amp; Organizers</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-top: var(--space-lg);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .page-header {
    padding-bottom: var(--space-lg);
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .group-header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-accent);
  }

  .group-header__icon .material-symbols-outlined {
    font-size: 28px;
  }

  .group-header__code {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
    margin-bottom: 2px;
  }

  .page-header__title {
    font-size: var(--font-size-4xl);
  }

  .page-header__desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
    margin-bottom: var(--space-md);
  }

  .member-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .member-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .member-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .member-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .member-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-glow);
  }

  .member-card__avatar {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-paper-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .member-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-card__initials {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-subtle);
  }

  .member-card__body {
    min-width: 0;
    flex: 1;
  }

  .member-card__name {
    font-size: var(--font-size-lg);
  }

  .member-card__role {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    margin-top: 2px;
  }

  .member-card__org {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    margin-top: 2px;
  }

  .member-card__bio {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: var(--line-height-relaxed);
    margin-top: var(--space-xs);
  }

  .member-card__links {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .member-card__links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
  }

  .member-card__links a:hover {
    color: var(--color-ink);
    border-color: var(--color-border-hover);
  }

  .member-card__links .material-symbols-outlined {
    font-size: 16px;
  }

  .back-link-row {
    margin-top: var(--space-2xl);
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .back-link .material-symbols-outlined {
    font-size: 18px;
  }
</style>
