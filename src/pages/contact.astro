---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const CONTACT_EMAIL = 'cncfpeshawar@gmail.com';

const inquiryTypes = [
  { value: 'General', label: 'General Question' },
  { value: 'Speaking / CFP', label: 'Speaking / CFP' },
  { value: 'Sponsorship', label: 'Sponsorship' },
  { value: 'Volunteering', label: 'Volunteering' },
];

const connectorTiles = [
  { label: 'Open Community Groups (OCG)', href: 'https://ocgroups.dev/cncf/group/6vwk2n4' },
  { label: 'CNCF Slack (#peshawar)', href: 'https://slack.cncf.io' },
  { label: 'GitHub Organization', href: 'https://github.com/cncf-peshawar' },
  { label: 'LinkedIn Company Page', href: 'https://www.linkedin.com/company/cloud-native-cncf-peshawar/' },
];

const faqs = [
  { q: 'How do I submit a talk?', a: 'Use the Speaking / CFP option in this form, or visit the Speak & CFP page for session formats and mentorship details.', href: `${base}/speak`, cta: 'Go to Speak & CFP' },
  { q: 'How can my company sponsor a meetup?', a: 'Select Sponsorship above, or see our current partnership tiers and perks on the Sponsors page.', href: `${base}/sponsors`, cta: 'View Sponsorship Tiers' },
  { q: 'What are the community standards?', a: 'CNCF Peshawar follows the official Linux Foundation & CNCF Community Code of Conduct at every event.', href: `${base}/code-of-conduct`, cta: 'Read the Code of Conduct' },
];
---

<BaseLayout
  title="Contact | CNCF Peshawar"
  description="Get in touch with the CNCF Peshawar organizing team — general questions, speaking proposals, sponsorship, and volunteering."
>
  <section class="page-header section">
    <div class="container">
      <span class="badge badge--live">Get in Touch</span>
      <h1 class="page-header__title">Talk to the Organizing Team.</h1>
      <p class="page-header__desc">
        Questions, a talk idea, a sponsorship proposal, or you'd like to volunteer — this reaches the same organizers who run every meetup.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <!-- Coordinates -->
      <div class="coordinates-card">
        <h2 class="coordinates-card__title">Community Coordinates</h2>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Email</span>
          <div class="coordinate-row__value-group">
            <a href={`mailto:${CONTACT_EMAIL}`} class="coordinate-row__value">{CONTACT_EMAIL}</a>
            <button type="button" class="copy-btn" id="copy-email-btn" aria-label="Copy email address">Copy</button>
          </div>
        </div>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Typical Venue</span>
          <span class="coordinate-row__value">NIC (National Incubation Center), South Canal Road, Peshawar</span>
        </div>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Response Time</span>
          <span class="coordinate-row__value">We're volunteer-run — expect a reply within a few days, faster closer to an event.</span>
        </div>

        <div class="connector-tiles">
          {connectorTiles.map((tile) => (
            <a href={tile.href} target="_blank" rel="noopener noreferrer" class="connector-tile">
              <span>{tile.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16" /></svg>
            </a>
          ))}
        </div>

        <p class="coordinates-card__note">
          Governed by the <a href="https://www.linuxfoundation.org" target="_blank" rel="noopener noreferrer">Linux Foundation</a> & CNCF's shared community standards. See our <a href={`${base}/about`}>chapter governance</a>.
        </p>
      </div>

      <!-- Form -->
      <div class="contact-form-card">
        <h2 class="contact-form-card__title">Send a Message</h2>

        <form id="contact-form" class="form-stack">
          <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="true" />
          <input type="hidden" id="contact-subject-field" name="_subject" value="CNCF Peshawar — General Question" />

          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Full Name <span class="required">*</span></label>
              <input type="text" id="contact-name" name="name" class="form-input" required />
            </div>
            <div class="form-group">
              <label for="contact-email">Email <span class="required">*</span></label>
              <input type="email" id="contact-email" name="email" class="form-input" required />
            </div>
          </div>

          <div class="form-group">
            <label id="inquiry-type-label">Inquiry Type</label>
            <div class="radio-card-group" role="radiogroup" aria-labelledby="inquiry-type-label">
              {inquiryTypes.map((type, i) => (
                <label class="radio-card">
                  <input type="radio" name="inquiry_type" value={type.value} checked={i === 0} />
                  <span>{type.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject <span class="required">*</span></label>
            <input type="text" id="contact-subject" name="subject" class="form-input" required />
          </div>

          <div class="form-group">
            <label for="contact-message">Message <span class="required">*</span></label>
            <textarea id="contact-message" name="message" rows="5" class="form-textarea" required></textarea>
          </div>

          <p class="form-note">
            Sent via a free community form-relay service (FormSubmit.co) directly to our organizer inbox — no account or data collection beyond delivering your message.
          </p>

          <button type="submit" class="btn btn--accent" id="contact-submit-btn">
            <span id="contact-submit-label">Send Message</span>
          </button>

          <p id="contact-result" class="form-result" role="status" hidden></p>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--subtle">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">FAQ</span>
        <h2 class="section-header__title">Common Questions.</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card">
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
            <a href={faq.href}>{faq.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-lg);
  }

  .page-header__title {
    font-size: var(--font-size-5xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .page-header__desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .coordinates-card,
  .contact-form-card {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .coordinates-card__title,
  .contact-form-card__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-lg);
  }

  .coordinate-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .coordinate-row__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-ink-subtle);
  }

  .coordinate-row__value {
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }

  a.coordinate-row__value:hover {
    color: var(--color-accent);
  }

  .coordinate-row__value-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .copy-btn {
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    cursor: pointer;
  }

  .copy-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-border-hover);
  }

  .connector-tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .connector-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .connector-tile:hover {
    border-color: var(--color-border-hover);
    color: var(--color-accent);
  }

  .coordinates-card__note {
    margin-top: var(--space-lg);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
    line-height: var(--line-height-relaxed);
  }

  .coordinates-card__note a {
    color: var(--color-accent);
  }

  .form-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .radio-card-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xs);
  }

  @media (min-width: 480px) {
    .radio-card-group {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .radio-card span {
    font-size: var(--font-size-xs);
    color: var(--color-ink);
  }

  .form-note {
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
  }

  .form-result {
    font-size: var(--font-size-sm);
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .form-result.is-success {
    border-color: var(--color-signal-green);
    color: var(--color-signal-green);
  }

  .form-result.is-error {
    border-color: var(--color-signal-pink);
    color: var(--color-signal-pink);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .faq-card {
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .faq-card h3 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2xs);
  }

  .faq-card p {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-sm);
  }

  .faq-card a {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }
</style>

<script define:vars={{ CONTACT_EMAIL }}>
  function initContactPage() {
    const copyBtn = document.getElementById('copy-email-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(CONTACT_EMAIL);
        window.cncfToast?.('Email address copied');
      } catch {
        window.cncfToast?.('Could not copy — select the address manually');
      }
    });

    const form = document.getElementById('contact-form');
    const subjectField = document.getElementById('contact-subject-field');
    const radios = form?.querySelectorAll('input[name="inquiry_type"]');
    radios?.forEach((radio) => {
      radio.closest('.radio-card')?.classList.toggle('is-checked', radio.checked);
    });
    radios?.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (subjectField && radio.checked) {
          subjectField.value = `CNCF Peshawar — ${radio.value}`;
        }
        radios.forEach((r) => r.closest('.radio-card')?.classList.toggle('is-checked', r.checked));
      });
    });

    const submitBtn = document.getElementById('contact-submit-btn');
    const submitLabel = document.getElementById('contact-submit-label');
    const resultEl = document.getElementById('contact-result');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !submitBtn || !submitLabel || !resultEl) return;

      const honeypot = form.querySelector('input[name="_honey"]');
      if (honeypot && honeypot.value) return; // bot caught by honeypot, silently drop

      submitBtn.setAttribute('disabled', 'true');
      submitLabel.textContent = 'Sending…';
      resultEl.hidden = true;
      resultEl.classList.remove('is-success', 'is-error');

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${CONTACT_EMAIL}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error('Non-200 response');

        resultEl.textContent = "Message sent — we'll get back to you soon. (First-time senders: check your inbox once for a one-time FormSubmit confirmation link.)";
        resultEl.classList.add('is-success');
        resultEl.hidden = false;
        window.cncfToast?.('Message sent');
        form.reset();
      } catch {
        resultEl.textContent = `Something went wrong sending that. Please email us directly at ${CONTACT_EMAIL}.`;
        resultEl.classList.add('is-error');
        resultEl.hidden = false;
        window.cncfToast?.('Could not send — see the form for details');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitLabel.textContent = 'Send Message';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactPage);
  } else {
    initContactPage();
  }
  document.addEventListener('astro:page-load', initContactPage);
</script>
