---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const CONTACT_EMAIL = 'cncfpeshawar@gmail.com';

const inquiryTypes = [
  { value: 'General', label: 'General Inquiry' },
  { value: 'Speaking / CFP', label: 'Speaking / CFP' },
  { value: 'Sponsorship', label: 'Sponsorship' },
  { value: 'Volunteering', label: 'Volunteering' },
];

const connectorTiles = [
  { label: 'Open Community Groups (OCG)', href: 'https://ocgroups.dev/cncf/group/6vwk2n4' },
  { label: 'CNCF Slack (#peshawar)', href: 'https://slack.cncf.io' },
  { label: 'GitHub Organization', href: 'https://github.com/cncf-peshawar' },
  { label: 'LinkedIn Company Page', href: 'https://www.linkedin.com/company/cloud-native-cncf-peshawar/' },
];

const faqs = [
  {
    q: 'How do I submit a talk proposal?',
    a: 'Visit the Speak & CFP page for formats, mentorship details, and our structured submission guidelines.',
    href: `${base}/speak`,
    cta: 'Go to Speak & CFP'
  },
  {
    q: 'How can our company sponsor a meetup?',
    a: 'Review our community sponsorship tiers and generate an inquiry on the Sponsors page.',
    href: `${base}/sponsors`,
    cta: 'View Sponsorship Tiers'
  },
  {
    q: 'What code of conduct applies to community interactions?',
    a: 'CNCF Peshawar adheres strictly to the official Linux Foundation & CNCF Community Code of Conduct.',
    href: `${base}/code-of-conduct`,
    cta: 'Read the Code of Conduct'
  },
];
---

<BaseLayout
  title="Contact Organizers | CNCF Peshawar"
  description="Get in touch with the Cloud Native Peshawar organizing team for general inquiries, speaking proposals, sponsorships, and volunteer partnerships."
>
  <section class="page-header section">
    <div class="container">
      <span class="badge badge--live">Get in Touch</span>
      <h1 class="page-header__title">Talk to the Organizing Team.</h1>
      <p class="page-header__desc">
        Have questions, a talk idea, a partnership proposal, or want to volunteer? Send a message below or email us directly.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <!-- Community Coordinates -->
      <div class="coordinates-card">
        <h2 class="coordinates-card__title">Community Coordinates</h2>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Direct Email</span>
          <div class="coordinate-row__value-group">
            <a href={`mailto:${CONTACT_EMAIL}`} class="coordinate-row__value">{CONTACT_EMAIL}</a>
            <button type="button" class="copy-btn" id="copy-email-btn" aria-label="Copy direct email address">Copy</button>
          </div>
        </div>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Typical Venue</span>
          <span class="coordinate-row__value">NIC (National Incubation Center), South Canal Road, Peshawar</span>
        </div>

        <div class="coordinate-row">
          <span class="coordinate-row__label">Response Expectations</span>
          <span class="coordinate-row__value">We are a volunteer-run chapter. We typically reply within 2–3 business days, or faster leading up to a meetup.</span>
        </div>

        <div class="connector-tiles">
          {connectorTiles.map((tile) => (
            <a href={tile.href} target="_blank" rel="noopener noreferrer" class="connector-tile">
              <span>{tile.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16" /></svg>
            </a>
          ))}
        </div>

        <p class="coordinates-card__note">
          Governed by the <a href="https://www.linuxfoundation.org" target="_blank" rel="noopener noreferrer">Linux Foundation</a> &amp; CNCF's shared community standards. Read our <a href={`${base}/code-of-conduct`}>Code of Conduct</a>.
        </p>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-card">
        <h2 class="contact-form-card__title">Send a Message</h2>

        <form id="contact-form" class="form-stack" data-contact-email={CONTACT_EMAIL} novalidate>
          <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" id="contact-subject-field" name="_subject" value="CNCF Peshawar — General Inquiry" />

          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">Full Name <span class="required">*</span></label>
              <input type="text" id="contact-name" name="name" class="form-input" required autocomplete="name" placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="contact-email">Email Address <span class="required">*</span></label>
              <input type="email" id="contact-email" name="email" class="form-input" required autocomplete="email" placeholder="your@email.com" />
            </div>
          </div>

          <div class="form-group">
            <label id="inquiry-type-label">Inquiry Type</label>
            <div class="radio-card-group" role="radiogroup" aria-labelledby="inquiry-type-label">
              {inquiryTypes.map((type, i) => (
                <label class="radio-card">
                  <input type="radio" name="inquiry_type" value={type.value} checked={i === 0} />
                  <span>{type.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject <span class="required">*</span></label>
            <input type="text" id="contact-subject" name="subject" class="form-input" required placeholder="What is your message about?" />
          </div>

          <div class="form-group">
            <label for="contact-message">Message <span class="required">*</span></label>
            <textarea id="contact-message" name="message" rows="5" class="form-textarea" required placeholder="Share the details of your inquiry..."></textarea>
          </div>

          <!-- Third-Party Relay & Privacy Disclosure -->
          <div class="form-disclosure">
            <p>
              FormSubmit.co processes your submission and forwards it to <code>{CONTACT_EMAIL}</code>. FormSubmit may retain submission data for up to 30 days and provides organizers with access to a submission archive. Read the <a href="https://formsubmit.co/privacy" target="_blank" rel="noopener noreferrer">FormSubmit Privacy Policy</a> and <a href="https://formsubmit.co/documentation" target="_blank" rel="noopener noreferrer">service documentation</a>.
            </p>
            <p class="form-disclosure__direct">
              Prefer to bypass the form relay? Email us directly at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
            </p>
          </div>

          <button type="submit" class="btn btn--accent" id="contact-submit-btn">
            <span id="contact-submit-label">Send Message</span>
          </button>

          <div id="contact-result" class="form-result" role="status" aria-live="polite" hidden></div>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section--subtle">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">FAQ</span>
        <h2 class="section-header__title">Common Questions.</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card">
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
            <a href={faq.href}>{faq.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-lg);
  }

  .page-header__title {
    font-size: var(--font-size-5xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .page-header__desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .coordinates-card,
  .contact-form-card {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .coordinates-card__title,
  .contact-form-card__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-lg);
  }

  .coordinate-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .coordinate-row__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-ink-subtle);
  }

  .coordinate-row__value {
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }

  a.coordinate-row__value:hover {
    color: var(--color-accent);
  }

  .coordinate-row__value-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .copy-btn {
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .copy-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-border-hover);
  }

  .connector-tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .connector-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.6rem var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .connector-tile:hover {
    border-color: var(--color-border-hover);
    color: var(--color-accent);
  }

  .coordinates-card__note {
    margin-top: var(--space-lg);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
    line-height: var(--line-height-relaxed);
  }

  .coordinates-card__note a {
    color: var(--color-accent);
  }

  .form-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
  }

  .required {
    color: var(--color-accent);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus-visible,
  .form-textarea:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .radio-card-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xs);
  }

  @media (min-width: 480px) {
    .radio-card-group {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .radio-card {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.5rem 0.65rem;
    min-height: 44px;
    font-size: var(--font-size-xs);
    background-color: var(--color-paper-card-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .radio-card.is-checked {
    border-color: var(--color-accent);
    background-color: var(--color-accent-subtle);
  }

  .radio-card span {
    font-size: var(--font-size-xs);
    color: var(--color-ink);
  }

  .form-disclosure {
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
    line-height: var(--line-height-relaxed);
    background-color: var(--color-paper-subtle);
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .form-disclosure a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .form-disclosure__direct {
    margin-top: var(--space-2xs);
    font-weight: var(--font-weight-medium);
  }

  .form-result {
    font-size: var(--font-size-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    line-height: var(--line-height-normal);
  }

  .form-result.is-success {
    border-color: var(--color-signal-green);
    background-color: var(--color-signal-green-subtle);
    color: var(--color-signal-green-ink);
  }

  .form-result.is-error {
    border-color: var(--color-signal-pink);
    background-color: var(--color-signal-pink-subtle, oklch(0.96 0.05 15));
    color: var(--color-signal-pink);
  }

  .form-result a {
    color: currentColor;
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .faq-card {
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .faq-card h3 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2xs);
  }

  .faq-card p {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-sm);
  }

  .faq-card a {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }
</style>

<script is:inline type="module" src={`${base}/scripts/contact-form.js`}></script>
