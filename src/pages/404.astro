---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout 
  title="404 — Page Not Found | CNCF Peshawar" 
  description="The requested page could not be found on Cloud Native Peshawar."
>
  <section class="not-found-section section">
    <div class="container text-center">
      <span class="badge badge--accent">Error 404 // Resource Missing</span>
      <h1 class="not-found-title">Page Not Found.</h1>
      <p class="not-found-desc">
        The route or resource you are looking for has been moved, renamed, or is currently unavailable.
      </p>

      <div class="not-found-actions">
        <a href={`${base}/`} class="btn btn--accent">
          <span>Return to Homepage</span>
        </a>
        <a href={`${base}/events`} class="btn btn--secondary">
          <span>Explore Events</span>
        </a>
        <a href={`${base}/speak`} class="btn btn--secondary">
          <span>Speaker Hub (CFP)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    padding-block: clamp(var(--space-2xl), 10vw, var(--space-3xl));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
  }

  .text-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .not-found-desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
    margin-bottom: var(--space-2xl);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }
</style>
