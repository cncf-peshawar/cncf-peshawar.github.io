---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Code of Conduct | CNCF Peshawar" 
  description="CNCF Peshawar follows the official Cloud Native Computing Foundation Community Code of Conduct to ensure an inclusive, welcoming, and harassment-free environment."
>
  <!-- Page Hero -->
  <section class="page-hero" data-reveal>
    <div class="page-hero__inner">
      <div class="page-hero__eyebrow">
        <span class="badge badge--live">COMMUNITY STANDARDS</span>
        <span class="eyebrow-text">LINUX FOUNDATION POLICY</span>
      </div>
      <h1 class="page-hero__title">Code of Conduct.</h1>
      <p class="page-hero__desc">
        CNCF Peshawar is dedicated to providing a harassment-free and inclusive experience for everyone, regardless of gender, sexual orientation, disability, physical appearance, body size, race, or religion.
      </p>
    </div>
  </section>

  <!-- Prose Content -->
  <article class="section-wrap" data-reveal>
    <div class="prose prose--article">
      <h2>1. Our Pledge</h2>
      <p>
        In the interest of fostering an open and welcoming environment, we as contributors and maintainers pledge to make participation in our community a harassment-free experience for everyone, regardless of age, body size, visible or invisible disability, ethnicity, sex characteristics, gender identity and expression, level of experience, education, socio-economic status, nationality, personal appearance, race, religion, or sexual identity and orientation.
      </p>

      <h2>2. Our Standards</h2>
      <p>Examples of behavior that contributes to a positive environment include:</p>
      <ul>
        <li>Using welcoming and inclusive language</li>
        <li>Being respectful of differing viewpoints and experiences</li>
        <li>Gracefully accepting constructive criticism</li>
        <li>Focusing on what is best for the community</li>
        <li>Showing empathy towards other community members</li>
      </ul>

      <p>Examples of unacceptable behavior include:</p>
      <ul>
        <li>The use of sexualized language or imagery, and unwelcome sexual attention or advances</li>
        <li>Trolling, insulting or derogatory comments, and personal or political attacks</li>
        <li>Public or private harassment</li>
        <li>Publishing others' private information, such as a physical or email address, without their explicit permission</li>
        <li>Other conduct which could reasonably be considered inappropriate in a professional setting</li>
      </ul>

      <h2>3. Enforcement &amp; Incident Reporting</h2>
      <p>
        Instances of abusive, harassing, or otherwise unacceptable behavior may be reported to the CNCF Peshawar Chapter organizers:
      </p>

      <div class="report-box brutal-card">
        <p class="report-line">
          <strong>Chapter Organizers:</strong>
          <a href="mailto:cncfpeshawar@gmail.com">cncfpeshawar@gmail.com</a>
        </p>
        <p class="report-line">
          <strong>CNCF Global Conduct Committee:</strong>
          <a href="mailto:conduct@cncf.io">conduct@cncf.io</a>
        </p>
      </div>

      <p>
        All reports will be reviewed and investigated promptly and fairly. Organizers are obligated to respect the privacy and security of the reporter of any incident.
      </p>

      <h2>4. Attribution</h2>
      <p>
        This Code of Conduct is adapted from the <a href="https://github.com/cncf/foundation/blob/main/code-of-conduct.md" target="_blank" rel="noopener noreferrer">Linux Foundation and CNCF Community Code of Conduct</a>.
      </p>
    </div>
  </article>

  <!-- Marquee Strip -->
  <div class="marquee-container" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>KUBERNETES</span><span>·</span>
        <span>DEVOPS</span><span>·</span>
        <span>MLOPS</span><span>·</span>
        <span>DISTRIBUTED SYSTEMS</span><span>·</span>
        <span>AGENTIC AI</span><span>·</span>
        <span>100% FREE COMMUNITY</span><span>·</span>
        <span>OPEN TO ALL BUILDERS</span><span>·</span>
        <span>KHYBER PAKHTUNKHWA</span><span>·</span>
      </div>
      <div class="marquee-content">
        <span>KUBERNETES</span><span>·</span>
        <span>DEVOPS</span><span>·</span>
        <span>MLOPS</span><span>·</span>
        <span>DISTRIBUTED SYSTEMS</span><span>·</span>
        <span>AGENTIC AI</span><span>·</span>
        <span>100% FREE COMMUNITY</span><span>·</span>
        <span>OPEN TO ALL BUILDERS</span><span>·</span>
        <span>KHYBER PAKHTUNKHWA</span><span>·</span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @import '../styles/prose.css';

  /* ------------------------------------------------------------------ */
  /* HERO STYLES                                                        */
  /* ------------------------------------------------------------------ */
  .page-hero {
    padding: var(--spacing-64) var(--spacing-24) var(--spacing-48);
    background-color: var(--color-cream-paper);
    border-bottom: 2px solid var(--color-charcoal-ink);
    position: relative;
  }

  .page-hero__inner {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  .page-hero__eyebrow {
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-12);
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .eyebrow-text {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .page-hero__title {
    font-family: var(--font-mono);
    font-size: var(--font-size-display);
    font-weight: 700;
    line-height: var(--line-height-snug);
    letter-spacing: -0.02em;
    color: var(--color-charcoal-ink);
    margin-bottom: var(--spacing-16);
    text-transform: uppercase;
  }

  .page-hero__desc {
    font-family: var(--font-mono);
    font-size: var(--font-size-subheading);
    color: var(--color-charcoal-ink);
    line-height: var(--line-height-relaxed);
  }

  /* ------------------------------------------------------------------ */
  /* SECTION WRAP & REPORT BOX                                          */
  /* ------------------------------------------------------------------ */
  .section-wrap {
    padding: var(--spacing-60) var(--spacing-24);
    max-width: var(--page-max-width);
    margin: 0 auto;
    position: relative;
  }

  .brutal-card {
    background: var(--color-frost-white);
    border: 2px solid var(--color-charcoal-ink);
    border-radius: var(--radius-brutal);
    box-shadow: var(--shadow-hard-sm);
    padding: var(--spacing-20);
    position: relative;
  }

  .report-box {
    margin-block: var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .report-line {
    margin: 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-6, 6px);
    align-items: center;
  }

  .report-line a {
    color: var(--color-charcoal-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-sky-crayon);
  }

  .report-line a:hover {
    background-color: var(--color-ice-wash);
  }

  /* ------------------------------------------------------------------ */
  /* BADGES                                                             */
  /* ------------------------------------------------------------------ */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-6, 6px);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-brutal);
    border: 1px solid var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
  }

  .badge--live {
    background: var(--color-ice-wash);
    color: var(--color-charcoal-ink);
  }

  /* ------------------------------------------------------------------ */
  /* MARQUEE STRIP                                                      */
  /* ------------------------------------------------------------------ */
  .marquee-container {
    width: 100%;
    background: var(--color-canary-banner);
    border-top: 2px solid var(--color-charcoal-ink);
    border-bottom: 2px solid var(--color-charcoal-ink);
    overflow: hidden;
    padding: 10px 0;
    white-space: nowrap;
    user-select: none;
  }

  .marquee-track {
    display: inline-flex;
    animation: marqueeScroll 25s linear infinite;
  }

  .marquee-content {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-24);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-weight: 700;
    color: var(--color-charcoal-ink);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    padding-right: var(--spacing-24);
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ------------------------------------------------------------------ */
  /* PREFERS-REDUCED-MOTION (PRM)                                       */
  /* ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .marquee-track {
      animation: none !important;
    }
  }
</style>
