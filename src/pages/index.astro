    // 1. Marquee Pause Toggle
    const marqueeBtn = document.getElementById('marquee-toggle-btn');
    const marqueeTrack = document.getElementById('marquee-track');
    if (marqueeBtn && marqueeTrack) {
      marqueeBtn.addEventListener('click', () => {
        const isPaused = marqueeTrack.classList.toggle('is-paused');
        marqueeBtn.textContent = isPaused ? 'PLAY' : 'PAUSE';
      });
    }

    // 2. Sponsorship Email Builder
    const orgInput = document.getElementById('org-name') as HTMLInputElement | null;
    const contactInput = document.getElementById('contact-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
    const tierSelect = document.getElementById('tier-select') as HTMLSelectElement | null;
    const timelineSelect = document.getElementById('timeline-select') as HTMLSelectElement | null;
    const websiteInput = document.getElementById('org-website') as HTMLInputElement | null;
    const notesInput = document.getElementById('scope-notes') as HTMLTextAreaElement | null;
    const previewEl = document.getElementById('email-preview-text');
    const mailtoBtn = document.getElementById('send-mailto-btn') as HTMLAnchorElement | null;
    const copyBtn = document.getElementById('copy-template-btn');
    const copyText = document.getElementById('copy-btn-text');

    function updatePreview() {
      const org = orgInput?.value.trim() || '[Organization / Company Name]';
      const contact = contactInput?.value.trim() || '[Contact Person, Role]';
      const email = emailInput?.value.trim() || '[Contact Email Address]';
      const tier = tierSelect?.value || 'Refreshment Partner (Community Hospitality)';
      const timeline = timelineSelect?.value || 'Next Upcoming Meetup';
      const website = websiteInput?.value.trim() || '[Website URL / Logo Asset Link]';
      const notes = notesInput?.value.trim() || '[Details on venue capacity, refreshment contribution, or swag vouchers]';

      const subject = 'CNCF Peshawar Sponsorship Inquiry — ' + org;
      const body = 'Hi Cloud Native Peshawar Organizers,\n\n' +
        'We would like to explore partnering with CNCF Peshawar to support free, high-quality cloud native and open-source education in Khyber Pakhtunkhwa.\n\n' +
        'Organization Overview:\n' +
        '- Organization / Company: ' + org + '\n' +
        '- Primary Contact: ' + contact + '\n' +
        '- Contact Email: ' + email + '\n' +
        '- Website / Logo Link: ' + website + '\n\n' +
        'Sponsorship Interest:\n' +
        '- Proposed Tier: ' + tier + '\n' +
        '- Target Event / Timeline: ' + timeline + '\n' +
        '- Support Scope / Logistics:\n' +
        '  ' + notes + '\n\n' +
        'We look forward to discussing the next steps and collaborating with the local cloud native community.\n\n' +
        'Best regards,\n' +
        contact + '\n' +
        org;

      if (previewEl) {
        previewEl.textContent = 'Subject: ' + subject + '\n\n' + body;
      }
      if (mailtoBtn) {
        mailtoBtn.href = 'mailto:cncfpeshawar@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      }
    }

    [orgInput, contactInput, emailInput, tierSelect, timelineSelect, websiteInput, notesInput].forEach(el => {
      if (el) {
        el.addEventListener('input', updatePreview);
        el.addEventListener('change', updatePreview);
      }
    });

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        if (previewEl) {
          try {
            await navigator.clipboard.writeText(previewEl.textContent || '');
            copyText.textContent = 'Copied to Clipboard!';
            setTimeout(() => {
              copyText.textContent = 'Copy Email Text';
            }, 2000);
          } catch (err) {
            copyText.textContent = 'Copy Failed';
          }
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomePage);
  } else {
    initHomePage();
  }
  document.addEventListener('astro:page-load', initHomePage);
</script>
