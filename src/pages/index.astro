---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import CFPBanner from '../components/CFPBanner.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allEvents = await getCollection('events');
const getTimestamp = (dateStr: string) => {
  const ts = new Date(dateStr).getTime();
  return isNaN(ts) ? 0 : ts;
};
const sortedEvents = allEvents.sort((a, b) => getTimestamp(b.data.date) - getTimestamp(a.data.date));
const upcomingEvents = allEvents
  .filter((e) => e.data.status === 'upcoming')
  .sort((a, b) => getTimestamp(a.data.date) - getTimestamp(b.data.date));
const pastEvents = sortedEvents.filter((e) => e.data.status === 'completed');
const featuredEvents = [...upcomingEvents, ...pastEvents].slice(0, 3);

const team = await getCollection('team');
const sponsors = await getCollection('sponsors');
---

<BaseLayout title="Cloud Native Peshawar — Official CNCF Community Group">
  <!-- Hero Section -->
  <Hero />

  <!-- Events Section -->
  <section class="section section--subtle" id="events">
    <div class="container">
      <div class="events-header">
        <div>
          <span class="section-header__num">Featured Sessions</span>
          <h2 class="section-header__title">Upcoming Meetups &amp; Workshops</h2>
          <p class="section-header__desc">Hands-on platform engineering, Kubernetes orchestration, and telemetry labs in Peshawar.</p>
        </div>
        <a href={`${base}/events`} class="btn btn--secondary btn--sm">
          <span>View All Events</span>
          <span class="material-symbols-outlined">north_east</span>
        </a>
      </div>

      {featuredEvents.length > 0 ? (
        <div class="events-grid">
          {featuredEvents.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <p class="events-empty">Our first meetup is being planned — check back soon, or join our OCG group to be notified.</p>
      )}
    </div>
  </section>

  <!-- Team Leadership Banner -->
  <section class="section" id="team">
    <div class="container">
      <div class="team-banner">
        <div>
          <span class="section-header__num">Community Leadership</span>
          <h3 class="team-banner__title">Meet the Organizers Guiding CNCF Peshawar</h3>
          <p class="team-banner__desc">{team.length} organizers, tech leads, and volunteers driving workshops and open source mentorship across KP.</p>
        </div>
        <a href={`${base}/team`} class="btn btn--secondary btn--sm">
          <span>View Full Team</span>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  {sponsors.length > 0 && (
    <section class="section section--subtle" id="sponsors">
      <div class="container">
        <div class="section-header section-header--center">
          <span class="section-header__num">Our Sponsors &amp; Partners</span>
          <h2 class="section-header__title">Empowering Open Source Innovation</h2>
          <p class="section-header__desc">
            Free community education, venue hospitality, and student travel stipends in Peshawar made possible by our generous ecosystem supporters.
          </p>
        </div>

        <div class="sponsors-grid">
          {sponsors.map((sponsor) => (
            <div class="sponsor-card">
              <span class="sponsor-card__tier">{sponsor.data.tier} Partner</span>
              <h3 class="sponsor-card__name">{sponsor.data.name}</h3>
              <p class="sponsor-card__desc">{sponsor.data.description}</p>
              <a href={sponsor.data.website} target="_blank" rel="noopener noreferrer" class="sponsor-card__link">
                <span>Visit Website</span>
                <span class="material-symbols-outlined">north_east</span>
              </a>
            </div>
          ))}
        </div>

        <div class="sponsor-callout">
          <div class="sponsor-callout__text">
            <span class="material-symbols-outlined">volunteer_activism</span>
            <span>Interested in sponsoring our next meetup? Support student travel grants and workshop infrastructure.</span>
          </div>
          <a href={`${base}/sponsors`} class="sponsor-callout__link">
            <span>Become a Sponsor</span>
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Contact / Get Involved -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-cta">
        <span class="section-header__num">Get Involved</span>
        <h2 class="contact-cta__title">Speak, Host or Sponsor a Session</h2>
        <p class="contact-cta__desc">
          Have a Kubernetes deployment story, eBPF insight, or architecture case study? We welcome student and industry speakers across Pakistan.
        </p>
        <div class="contact-cta__actions">
          <a href={`${base}/speak`} class="btn btn--accent">
            <span>Submit a Talk Proposal</span>
            <span class="material-symbols-outlined">record_voice_over</span>
          </a>
          <a href={`${base}/sponsors`} class="btn btn--secondary">
            <span>Sponsor Our Community</span>
            <span class="material-symbols-outlined">volunteer_activism</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call for Proposals Banner -->
  <CFPBanner />
</BaseLayout>

<style>
  /* Events Section */
  .events-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 768px) {
    .events-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .events-header .btn {
    white-space: nowrap;
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .events-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .events-empty {
    color: var(--color-ink-muted);
  }

  /* Team Banner */
  .team-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 768px) {
    .team-banner {
      flex-direction: row;
      align-items: center;
    }
  }

  .team-banner__title {
    font-size: var(--font-size-xl);
    color: var(--color-ink);
    margin-top: 2px;
  }

  .team-banner__desc {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    max-width: 55ch;
    margin-top: 4px;
  }

  .team-banner .btn {
    white-space: nowrap;
  }

  /* Sponsors */
  .section-header--center {
    text-align: center;
    align-items: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .sponsors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 768px) {
    .sponsors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sponsor-card {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(var(--space-md), 4vw, var(--space-xl));
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .sponsor-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-glow);
  }

  .sponsor-card__tier {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .sponsor-card__name {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-xs);
    color: var(--color-ink);
  }

  .sponsor-card__desc {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }

  .sponsor-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    margin-top: auto;
  }

  .sponsor-card__link .material-symbols-outlined {
    font-size: 14px;
  }

  .sponsor-callout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 640px) {
    .sponsor-callout {
      flex-direction: row;
      align-items: center;
    }
  }

  .sponsor-callout__text {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }

  .sponsor-callout__text .material-symbols-outlined {
    color: var(--color-signal-green);
    font-size: 22px;
  }

  .sponsor-callout__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .sponsor-callout__link .material-symbols-outlined {
    font-size: 16px;
  }

  /* Contact CTA */
  .contact-cta {
    max-width: 700px;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-xl);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .contact-cta__title {
    font-size: var(--font-size-3xl);
    margin-top: var(--space-2xs);
  }

  .contact-cta__desc {
    color: var(--color-ink-muted);
    max-width: 55ch;
    margin: var(--space-sm) auto var(--space-lg);
    line-height: var(--line-height-relaxed);
  }

  .contact-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .contact-cta .material-symbols-outlined {
    font-size: 18px;
  }
</style>
