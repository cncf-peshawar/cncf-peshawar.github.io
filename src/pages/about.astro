---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const team = await getCollection('team');
const events = await getCollection('events');
const speakers = await getCollection('speakers');
const sponsors = await getCollection('sponsors');
const completedEvents = events.filter((e) => e.data.status === 'completed');

const coreTechnologies = [
  { name: 'Kubernetes', status: 'Graduated', desc: 'Container orchestration — the substrate most of our hands-on labs are built on.', href: 'https://kubernetes.io' },
  { name: 'Prometheus', status: 'Graduated', desc: 'Metrics collection and alerting, covered in our observability sessions.', href: 'https://prometheus.io' },
  { name: 'Envoy', status: 'Graduated', desc: 'Service proxy and edge networking used in our service-mesh workshops.', href: 'https://www.envoyproxy.io' },
  { name: 'Helm', status: 'Graduated', desc: 'The package manager for Kubernetes, used throughout our GitOps material.', href: 'https://helm.sh' },
  { name: 'OpenTelemetry', status: 'Incubating', desc: 'Vendor-neutral tracing, metrics, and logging instrumentation.', href: 'https://opentelemetry.io' },
  { name: 'Argo', status: 'Graduated', desc: 'GitOps continuous delivery for Kubernetes (Argo CD, Argo Workflows).', href: 'https://argoproj.github.io' },
];

const charterGuarantees = [
  'Vendor-neutral — no single company controls chapter direction or content.',
  'Governed by the CNCF and Linux Foundation Community Code of Conduct.',
  'Organized entirely by volunteer engineers, not paid staff.',
];
---

<BaseLayout
  title="About & Mission | CNCF Peshawar"
  description="What CNCF Peshawar is, how it's governed, and the cloud native projects our community explores — an official Cloud Native Computing Foundation community group."
>
  <!-- Page Header -->
  <section class="page-header section">
    <div class="container">
      <span class="badge badge--live">About the Chapter</span>
      <h1 class="page-header__title">Building Peshawar's Cloud Native Future.</h1>
      <p class="page-header__desc">
        CNCF Peshawar is an official Cloud Native Computing Foundation community group advancing Kubernetes, distributed systems, DevOps, MLOps, and open-source engineering in Khyber Pakhtunkhwa.
      </p>

      <!-- Sticky sub-nav -->
      <nav class="about-subnav" aria-label="On this page">
        <a href="#mission">Mission</a>
        <a href="#governance">Governance</a>
        <a href="#projects">Projects</a>
        <a href="#values">Values</a>
      </nav>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section--subtle" id="mission">
    <div class="container about-grid">
      <div class="about-grid__content">
        <span class="section-header__num">01 // MISSION</span>
        <h2 class="section-header__title">Why This Chapter Exists.</h2>
        <p>
          We bridge local students, developers, and practitioners in Peshawar with production-grade cloud native engineering — the same architectures, tooling, and open-source projects used at global scale by the Linux Foundation's ecosystem. Every session is hands-on: real clusters, real failure modes, real code, not slideware.
        </p>
        <p>
          As a community group under the CNCF umbrella, we exist to grow the region's open-source talent pool, connect it to the global cloud native community, and give first-time speakers and contributors a low-stakes place to start.
        </p>
      </div>
      <div class="about-grid__visual" aria-hidden="true">
        <svg viewBox="0 0 320 260" class="topology-art" role="img" aria-label="Decorative illustration of a clustered node network">
          <g stroke="var(--color-border)" stroke-width="1.5">
            <line x1="160" y1="60" x2="70" y2="130" />
            <line x1="160" y1="60" x2="160" y2="140" />
            <line x1="160" y1="60" x2="250" y2="130" />
            <line x1="70" y1="130" x2="70" y2="200" />
            <line x1="160" y1="140" x2="70" y2="200" />
            <line x1="160" y1="140" x2="250" y2="200" />
            <line x1="250" y1="130" x2="250" y2="200" />
          </g>
          <circle cx="160" cy="60" r="16" fill="var(--color-accent-subtle)" stroke="var(--color-accent)" stroke-width="2" />
          <circle cx="70" cy="130" r="12" fill="var(--color-paper-card)" stroke="var(--color-border-hover)" stroke-width="1.5" />
          <circle cx="160" cy="140" r="12" fill="var(--color-paper-card)" stroke="var(--color-border-hover)" stroke-width="1.5" />
          <circle cx="250" cy="130" r="12" fill="var(--color-paper-card)" stroke="var(--color-border-hover)" stroke-width="1.5" />
          <circle cx="70" cy="200" r="9" fill="var(--color-paper-subtle)" stroke="var(--color-signal-green)" stroke-width="1.5" />
          <circle cx="160" cy="200" r="9" fill="var(--color-paper-subtle)" stroke="var(--color-signal-green)" stroke-width="1.5" />
          <circle cx="250" cy="200" r="9" fill="var(--color-paper-subtle)" stroke="var(--color-signal-green)" stroke-width="1.5" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Governance -->
  <section class="section" id="governance">
    <div class="container about-grid about-grid--reverse">
      <div class="about-grid__content">
        <span class="section-header__num">02 // GOVERNANCE</span>
        <h2 class="section-header__title">How the Chapter Is Run.</h2>
        <p>
          CNCF Peshawar operates as a <a href="https://community.cncf.io" target="_blank" rel="noopener noreferrer">CNCF Community Group</a>, hosted on Open Community Groups (OCG) and bound by the Linux Foundation and CNCF's shared governance and conduct standards — the same framework every official CNCF chapter worldwide follows.
        </p>
        <ul class="charter-list">
          {charterGuarantees.map((item) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a href={`${base}/code-of-conduct`} class="btn btn--secondary btn--sm">Read the full Code of Conduct →</a>
      </div>
      <div class="about-grid__content">
        <div class="metrics-card">
          <span class="metrics-card__label">CHAPTER AT A GLANCE</span>
          <div class="metrics-grid">
            <div class="metric"><span class="metric__num">{team.length}</span><span class="metric__label">Team & Organizers</span></div>
            <div class="metric"><span class="metric__num">{events.length}</span><span class="metric__label">Events Hosted / Planned</span></div>
            <div class="metric"><span class="metric__num">{speakers.length}</span><span class="metric__label">Speakers Featured</span></div>
            <div class="metric"><span class="metric__num">{sponsors.length}</span><span class="metric__label">Community Partners</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Technologies -->
  <section class="section section--subtle" id="projects">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">03 // PROJECTS</span>
        <h2 class="section-header__title">The CNCF Ecosystem We Explore.</h2>
        <p class="section-header__desc">
          Our workshops and talks are built around real, widely-adopted CNCF projects — not proprietary tooling.
        </p>
      </div>
      <div class="tech-grid">
        {coreTechnologies.map((tech) => (
          <a href={tech.href} target="_blank" rel="noopener noreferrer" class="tech-card">
            <div class="tech-card__head">
              <h3>{tech.name}</h3>
              <span class={`badge ${tech.status === 'Graduated' ? 'badge--accent' : ''}`}>{tech.status}</span>
            </div>
            <p>{tech.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section" id="values">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">04 // VALUES</span>
        <h2 class="section-header__title">What We Hold Each Other To.</h2>
      </div>
      <div class="values-grid">
        <div class="values-card">
          <h3>Radical Inclusivity</h3>
          <p>Welcoming regardless of experience level, background, or which language you think in first — first-time speakers and first-time contributors are the point, not the exception.</p>
        </div>
        <div class="values-card">
          <h3>Enforcement, Not Just Policy</h3>
          <p>Our Code of Conduct is the Linux Foundation & CNCF's official standard, with clear, monitored reporting channels to chapter organizers and CNCF's Global Conduct Committee.</p>
        </div>
      </div>
      <a href={`${base}/code-of-conduct`} class="btn btn--accent">View Full Code of Conduct</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-lg);
  }

  .page-header__title {
    font-size: var(--font-size-5xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .page-header__desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
    margin-bottom: var(--space-lg);
  }

  .about-subnav {
    position: sticky;
    top: 64px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .about-subnav a {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .about-subnav a:hover {
    color: var(--color-accent);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .about-grid--reverse {
      grid-template-columns: 1fr 1fr;
    }
  }

  .about-grid__content p {
    margin-top: var(--space-sm);
    color: var(--color-ink-muted);
    line-height: var(--line-height-relaxed);
  }

  .about-grid__content a {
    color: var(--color-accent);
  }

  .about-grid__content .btn {
    margin-top: var(--space-md);
  }

  .about-grid__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .topology-art {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  .charter-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .charter-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--font-size-sm);
    color: var(--color-ink);
  }

  .charter-list svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .metrics-card {
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    width: 100%;
  }

  .metrics-card__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric__num {
    font-family: var(--font-mono);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
  }

  .metric__label {
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tech-card {
    display: block;
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tech-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-glow);
  }

  .tech-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .tech-card__head h3 {
    font-size: var(--font-size-lg);
  }

  .tech-card p {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .values-card {
    padding: var(--space-lg);
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .values-card h3 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-xs);
  }

  .values-card p {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: var(--line-height-relaxed);
  }
</style>
