---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const events = await getCollection('events');
const genesisEvent = events.find((e) => e.slug === '01-cncf-peshawar-genesis') ?? events[0];

const dateFormatted = genesisEvent
  ? new Date(genesisEvent.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
---

<BaseLayout
  title="Genesis Recap | CNCF Peshawar"
  description="Recap of the CNCF Peshawar Genesis kickoff event — full session timeline and photos coming soon."
>
  <!-- Breadcrumb -->
  <div class="breadcrumb container">
    <a href={`${base}/`}>Home</a>
    <span>/</span>
    <a href={`${base}/events`}>Events</a>
    <span>/</span>
    <span>Genesis Recap</span>
  </div>

  <!-- Hero -->
  <section class="page-header section">
    <div class="container">
      <span class="badge badge--live">Recap — In Progress</span>
      <h1 class="page-header__title">
        {genesisEvent ? genesisEvent.data.title : 'CNCF Peshawar Genesis'} Recap.
      </h1>
      <p class="page-header__desc">
        {dateFormatted
          ? `Held ${dateFormatted} at ${genesisEvent?.data.venue}. We're still assembling the full session timeline, speaker recordings, and photo gallery from this event — check back soon, or follow our channels for updates.`
          : "We're still assembling the recap for this event — check back soon."}
      </p>
      <div class="pending-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
        <span>This page is a placeholder. Session details, speaker recordings, and photos below are marked TBD until we publish the real recap.</span>
      </div>
    </div>
  </section>

  <!-- Session timeline placeholder -->
  <section class="section section--subtle">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">01 // SESSION TIMELINE</span>
        <h2 class="section-header__title">What Happened.</h2>
      </div>
      <div class="timeline">
        <div class="timeline__item placeholder-block">
          <span class="placeholder-tag">TBD</span>
          <p>Opening & welcome remarks — details coming soon.</p>
        </div>
        <div class="timeline__item placeholder-block">
          <span class="placeholder-tag">TBD</span>
          <p>Keynote / technical session recap — details coming soon.</p>
        </div>
        <div class="timeline__item placeholder-block">
          <span class="placeholder-tag">TBD</span>
          <p>Interactive activities & networking recap — details coming soon.</p>
        </div>
        <div class="timeline__item placeholder-block">
          <span class="placeholder-tag">TBD</span>
          <p>Closing & next steps — details coming soon.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo gallery placeholder -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-header__num">02 // GALLERY</span>
        <h2 class="section-header__title">Photos.</h2>
      </div>
      <div class="photo-grid">
        <div class="photo-placeholder photo-placeholder--large">Photo pending</div>
        <div class="photo-placeholder">Photo pending</div>
        <div class="photo-placeholder">Photo pending</div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section section--subtle">
    <div class="container closing-cta">
      <h2>Want the Full Recap First?</h2>
      <p>Join our community channels — we'll share the full write-up, slides, and photos there before anywhere else.</p>
      <div class="closing-cta__actions">
        <a href="https://ocgroups.dev/cncf/group/6vwk2n4" target="_blank" rel="noopener noreferrer" class="btn btn--accent">Join on OCG</a>
        <a href={`${base}/events`} class="btn btn--secondary">Browse Other Events</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-top: var(--space-lg);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .page-header {
    padding-bottom: var(--space-lg);
  }

  .page-header__title {
    font-size: var(--font-size-5xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .page-header__desc {
    font-size: var(--font-size-lg);
    color: var(--color-ink-muted);
    max-width: var(--container-prose);
    margin-bottom: var(--space-lg);
  }

  .pending-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-signal-amber-subtle);
    border: 1px solid var(--color-signal-amber);
    border-radius: var(--radius-sm);
    color: var(--color-signal-amber);
    font-size: var(--font-size-sm);
    max-width: var(--container-prose);
  }

  .pending-notice svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .placeholder-block {
    padding: var(--space-md);
    background-color: var(--color-paper-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .placeholder-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-signal-amber);
    border: 1px solid var(--color-signal-amber);
    border-radius: var(--radius-xs);
    padding: 0.1rem 0.5rem;
    flex-shrink: 0;
  }

  .placeholder-block p {
    color: var(--color-ink-muted);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .photo-placeholder--large {
      grid-column: span 3;
      aspect-ratio: 21 / 9;
    }
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    background-color: var(--color-paper-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .closing-cta {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .closing-cta h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-sm);
  }

  .closing-cta p {
    color: var(--color-ink-muted);
    margin-bottom: var(--space-lg);
  }

  .closing-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
</style>
