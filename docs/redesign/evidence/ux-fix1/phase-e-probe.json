  "cards": [
    {
      "path": "/team",
      "selector": ".exec-card",
      "before": {
        "duration": "0.2s, 0.2s",
        "transform": "matrix(1, 0, 0, 1, 0, 0)",
        "cursor": "auto",
        "classes": "exec-card brutal-card is-revealed reveal-settled"
      },
      "after": {
        "duration": "0.2s, 0.2s",
        "transform": "matrix(1, 0, 0, 1, 3, -3)",
        "cursor": "auto"
      }
    },
    {
      "path": "/team/tech-team",
      "selector": ".member-card",
      "before": {
        "duration": "0.2s, 0.2s",
        "transform": "none",
        "cursor": "auto",
        "classes": "member-card brutal-card is-revealed reveal-settled"
      },
      "after": {
        "duration": "0.2s, 0.2s",
        "transform": "matrix(1, 0, 0, 1, 3, -3)",
        "cursor": "auto"
      }
    },
    {
      "path": "/blog",
      "selector": ".post-card",
      "before": {
        "duration": "0.2s, 0.2s",
        "transform": "matrix(1, 0, 0, 1, 0, 0)",
        "cursor": "auto",
        "classes": "post-card brutal-card post-card--coral is-revealed reveal-settled"
      },
      "after": {
        "duration": "0.2s, 0.2s",
        "transform": "matrix(1, 0, 0, 1, 3, -3)",
        "cursor": "auto"
      }
    },
    {
      "path": "/speak",
      "selector": ".format-card",
      "before": {
        "duration": "0s",
        "transform": "none",
        "cursor": "auto",
        "classes": "card card--white card--pad-md card--accent-top-coral format-card"
      },
      "after": {
        "duration": "0s",
        "transform": "none",
        "cursor": "auto"
      }
    },
    {
      "path": "/sponsors",
      "selector": ".tier-card-wrapper .tier-card",
      "before": {
        "duration": "0.2s, 0.2s",
        "transform": "none",
        "cursor": "auto",
        "classes": "card card--white card--pad-md card--accent-top-lilac tier-card"
      },
      "after": {
        "duration": "0.2s, 0.2s",
        "transform": "none",
        "cursor": "auto"
      }
    }
